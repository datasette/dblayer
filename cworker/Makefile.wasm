# SQLite + the C worker's request handling, compiled to WebAssembly
# (wasm32-wasip1) for dblayer.backends.sqlite_wasm. Run it through the main
# Makefile, which fetches the SQLite amalgamation first:
#
#   make -C cworker wasm            # build-wasm/dblayer-sqlite.wasm
#
# The toolchain is a pinned wasi-sdk release, downloaded once into vendor/
# (git-ignored) and checked against the SHA-256 GitHub publishes for it. No
# global install. Python finds the module through an explicit path, then
# $DBLAYER_SQLITE_WASM, then cworker/build-wasm/dblayer-sqlite.wasm.

WASI_SDK_VERSION ?= 34
WASI_SDK_RELEASE ?= 34.0

UNAME_S := $(shell uname -s)
UNAME_M := $(shell uname -m)
ifeq ($(UNAME_S),Darwin)
WASI_OS := macos
else
WASI_OS := linux
endif
ifneq ($(filter arm64 aarch64,$(UNAME_M)),)
WASI_ARCH := arm64
else
WASI_ARCH := x86_64
endif
WASI_PLATFORM := $(WASI_ARCH)-$(WASI_OS)

# SHA-256 of each wasi-sdk-34.0 tarball (from the GitHub release's digests).
SHA256_arm64-macos := 9c59398106b417f8f14913380fdf0097a8cc0ff4af9eb3ce0065a859e88d49e9
SHA256_x86_64-macos := 87d27fa8adc68dee59bfbf2e22a6d34ef717c34d6bf1d8af2a56fc929d9ce0eb
SHA256_arm64-linux := f7e243dff54d60bcc576e94d6166b69f410f2500ae4a9ceef34315be10e77971
SHA256_x86_64-linux := b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4
WASI_SHA256 := $(SHA256_$(WASI_PLATFORM))

WASI_NAME := wasi-sdk-$(WASI_SDK_RELEASE)-$(WASI_PLATFORM)
WASI_TGZ := vendor/$(WASI_NAME).tar.gz
WASI_SDK ?= vendor/$(WASI_NAME)
WASI_CC := $(WASI_SDK)/bin/clang
WASI_SYSROOT := $(WASI_SDK)/share/wasi-sysroot

SQLITE_DIR ?= vendor/sqlite-amalgamation-3530100
BUILD := build-wasm
OUT := $(BUILD)/dblayer-sqlite.wasm

TARGET := --target=wasm32-wasip1 --sysroot=$(WASI_SYSROOT)
OPT ?= -O2
WARN := -std=c11 -Wall -Wextra -Wshadow -Wstrict-prototypes -Wmissing-prototypes \
	-Wno-unused-function -Wno-unused-parameter -Wno-unused-variable \
	-Wno-unused-but-set-global -Wno-missing-prototypes

# As the native C worker (python-build-standalone's options), but
# single-threaded, no extensions, no mmap, and SQLITE_OS_OTHER: the only VFS
# is src/wasm_vfs.c, whose file I/O and locks are host (Python) functions.
SQLITE_DEFS := -DSQLITE_THREADSAFE=0 -DSQLITE_OS_OTHER=1 -DSQLITE_OMIT_LOAD_EXTENSION \
	-DSQLITE_MAX_MMAP_SIZE=0 -DSQLITE_ENABLE_FTS3 -DSQLITE_ENABLE_FTS3_PARENTHESIS \
	-DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_GEOPOLY \
	-DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_PERCENTILE -DSQLITE_ENABLE_DBSTAT_VTAB \
	-DSQLITE_DQS=3 -DSQLITE_DEFAULT_MEMSTATUS=1

SRC := src/worker.c src/codec.c src/sqlutil.c src/schema.c src/wasm_vfs.c
HDR := src/codec.h src/sqlutil.h src/errnames.h src/wasm_host.h
OBJ := $(patsubst src/%.c,$(BUILD)/%.o,$(SRC))

# Linear memory: starts at 2 MB and grows on demand up to the 4 GB wasm32
# ceiling; the host caps each instance (Store limits). The stack is 1 MB.
LDFLAGS := -mexec-model=reactor -Wl,--export-dynamic -Wl,-z,stack-size=1048576 \
	-Wl,--initial-memory=2097152 -Wl,--max-memory=4294967296 -Wl,--strip-debug

all: $(OUT)

$(OUT): $(OBJ) $(BUILD)/sqlite3.o
	$(WASI_CC) $(TARGET) $(OPT) $(LDFLAGS) -o $@ $^

$(BUILD)/%.o: src/%.c $(HDR) Makefile.wasm $(SQLITE_DIR)/sqlite3.h | $(BUILD) $(WASI_CC)
	$(WASI_CC) $(TARGET) $(OPT) $(WARN) -DCWORKER_WASM -DCWORKER_NO_LOAD_EXTENSION -I$(SQLITE_DIR) -c -o $@ $<

$(BUILD)/sqlite3.o: $(SQLITE_DIR)/sqlite3.c | $(BUILD) $(WASI_CC)
	$(WASI_CC) $(TARGET) $(OPT) $(SQLITE_DEFS) -c -o $@ $<

$(BUILD):
	mkdir -p $(BUILD)

$(WASI_CC): $(WASI_TGZ)
	cd vendor && tar xzf $(WASI_NAME).tar.gz
	touch $@

$(WASI_TGZ):
	@if [ -z "$(WASI_SHA256)" ]; then echo "no pinned wasi-sdk checksum for $(WASI_PLATFORM)" >&2; exit 1; fi
	mkdir -p vendor
	curl -fsSL -o $@.tmp https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-$(WASI_SDK_VERSION)/$(WASI_NAME).tar.gz
	@sum=$$( (sha256sum $@.tmp 2>/dev/null || shasum -a 256 $@.tmp) | cut -d' ' -f1); \
	if [ "$$sum" != "$(WASI_SHA256)" ]; then \
		echo "checksum mismatch for $@: got $$sum, expected $(WASI_SHA256)" >&2; rm -f $@.tmp; exit 1; \
	fi
	mv $@.tmp $@

toolchain: $(WASI_CC)

.PHONY: all toolchain
